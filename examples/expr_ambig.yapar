%token ID NUM PLUS MINUS TIMES LPAREN RPAREN SEMI

IGNORE WS
IGNORE NEWLINE

%%

program:
    stmt_list
    ;

stmt_list:
    stmt_list stmt
    | stmt
    ;

stmt:
    expr SEMI
    ;

expr:
    expr PLUS expr
    | expr MINUS expr
    | expr TIMES expr
    | LPAREN expr RPAREN
    | ID
    | NUM
    ;
